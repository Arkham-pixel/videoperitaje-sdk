# Servidor
PORT=3088
NODE_ENV=development

# Auth: Arnald (u otros clientes) envían header x-api-key
API_KEY=cambia-esta-clave

# Cors (origenes de Arnald separados por coma)
CORS_ORIGIN=http://localhost:5173,https://arnald.grupoproser.com.co

# --- Postgres (en Coolify usa el hostname interno del servicio) ---
# Opción A
# DATABASE_URL=postgresql://postgres:PASSWORD@NOMBRE_SERVICIO:5432/VideoPeritaje

# Opción B
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=VideoPeritaje
PGUSER=postgres
PGPASSWORD=
# 0 en red Docker interna; 1 si conectas por host público
PGSSL=0
