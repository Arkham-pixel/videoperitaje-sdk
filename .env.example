PORT=3000
NODE_ENV=development

# Auth: Arnald envía header x-api-key (genera una clave propia; no uses el placeholder)
API_KEY=

# Cors
CORS_ORIGIN=http://localhost:5173,https://arnald.grupoproser.com.co

# Postgres (Coolify: hostname interno del servicio)
# DATABASE_URL=postgresql://postgres:PASSWORD@NOMBRE_SERVICIO:5432/VideoPeritaje
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=VideoPeritaje
PGUSER=postgres
PGPASSWORD=
PGSSL=0
