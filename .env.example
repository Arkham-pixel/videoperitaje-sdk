PORT=3000
NODE_ENV=development

# Auth: Arnald envía header x-api-key (genera una clave propia; no uses el placeholder)
API_KEY=

# Cors
CORS_ORIGIN=http://localhost:5173,https://arnald.grupoproser.com.co

# Postgres (Coolify: hostname interno del servicio)
# DATABASE_URL=postgresql://postgres:PASSWORD@NOMBRE_SERVICIO:5432/VideoPeritaje
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=VideoPeritaje
PGUSER=postgres
PGPASSWORD=
PGSSL=0

# Auto-cierre obligatorio (en el SDK): en_proceso > duracion_max_minutos de la sesión
AUTO_CIERRE_ENABLED=1
AUTO_CIERRE_INTERVAL_MS=60000
AUTO_CIERRE_PENDIENTE_MAX_MIN=240

# Opcional: avisar a Arnald para cerrar Mongo + LiveKit
# ARNALD_CIERRE_WEBHOOK_URL=https://arnaldbackend.grupoproser.com.co/api/videoperitaje/hooks/sdk-cierre
# ARNALD_WEBHOOK_KEY=misma-que-API_KEY-o-VIDEOPERITAJE_SDK_KEY
